{
  "name": "TruckOpti",
  "description": "3D Smart Packing & Route Optimization for Indian Logistics",
  "repository": "https://github.com/yourusername/truckopti",
  "logo": "https://raw.githubusercontent.com/yourusername/truckopti/main/frontend/public/pwa-192x192.png",
  "keywords": [
    "react",
    "supabase",
    "logistics",
    "3d-packing",
    "truck",
    "india"
  ],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "VITE_SUPABASE_URL": {
      "description": "Supabase Project URL",
      "value": "https://YOUR_PROJECT_ID.supabase.co",
      "required": true
    },
    "VITE_SUPABASE_ANON_KEY": {
      "description": "Supabase Anon Key",
      "value": "your_supabase_anon_key_here",
      "required": true
    },
    "VITE_APP_URL": {
      "description": "Canonical production URL for Heroku → truckopti.in redirect",
      "value": "https://www.truckopti.in",
      "required": true
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
