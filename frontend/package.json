{
  "name": "truckopti-frontend",
  "version": "1.1.0",
  "description": "TruckOpti - Advanced Logistics Solution for India",
  "type": "module",
  "author": "TruckOpti Team",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:unit": "vitest run",
    "test:packing": "tsc -p tsconfig.packing-regression.json && node .tmp/packing-regression/scripts/packing-regression.js",
    "bench:packing": "tsc -p tsconfig.packing-benchmark.json && node .tmp/packing-benchmark/scripts/packing-benchmark.js",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 80"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@sentry/react": "^10.43.0",
    "@supabase/supabase-js": "^2.90.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/crypto-js": "^4.2.2",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "papaparse": "^5.5.3",
    "razorpay": "^2.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.0",
    "three": "^0.169.0",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/leaflet": "^1.9.21",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "logistics",
    "3d-bin-packing",
    "truck-loading",
    "route-optimization",
    "india"
  ],
  "overrides": {
    "dompurify": "^3.4.0",
    "esbuild": "^0.25.0",
    "follow-redirects": "^1.15.12",
    "serialize-javascript": "^7.0.3",
    "rollup": "^4.0.0",
    "ws": "8.20.1"
  }
}