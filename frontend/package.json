{
  "name": "truckopti-frontend",
  "version": "1.1.0",
  "description": "TruckOpti - Advanced Logistics Solution for India",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "TruckOpti Team",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:build:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.truckopti.app",
    "productName": "TruckOpti",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "TruckOpti-${version}-Portable.exe"
    }
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@sentry/react": "^10.43.0",
    "@supabase/supabase-js": "^2.90.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/crypto-js": "^4.2.2",
    "axios": "^1.7.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "papaparse": "^5.5.3",
    "razorpay": "^2.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.0",
    "three": "^0.169.0",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9.14.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^9.0.3"
  },
  "keywords": [
    "logistics",
    "3d-bin-packing",
    "truck-loading",
    "route-optimization",
    "india"
  ],
  "overrides": {
    "dompurify": "^3.3.2",
    "esbuild": "^0.25.0",
    "serialize-javascript": "^7.0.3",
    "rollup": "^4.0.0"
  }
}
