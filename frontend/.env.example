# Copy this file to .env and fill in your credentials
# NEVER commit real credentials to version control
#
# Capability note (TO-124): placeholder values (anything containing "your_",
# "replace_me" or "placeholder") are detected as UNCONFIGURED — the app runs in
# local-first mode and never sends requests to a placeholder backend. A value
# being present is not proof of reachability; reachability and live
# verification are checked separately.

# Supabase Configuration (optional — local-first mode works without it)
# Cloud sign-in (Google OAuth, Email/Phone OTP) requires BOTH values to be set
# to real values. The anon key is the public client key; keep server secrets
# out of VITE_ variables entirely.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_AUTH_EMAIL_OTP_ENABLED=false    # keep false: login is Google-only
VITE_AUTH_PHONE_OTP_ENABLED=false      # set true only after Supabase Phone is configured with Twilio/Twilio Verify
VITE_AUTH_PASSWORD_ENABLED=false       # office/reviewer/demo password login; requires the approved Supabase
                                       # password policy (minimum 8 characters, see supabase/config.toml)
                                       # and office account provisioning to be verified live

# Google sign-in runs as a trusted Supabase OAuth round trip (provider
# configured in the Supabase dashboard by the owner). The app no longer uses a
# Google Identity Services (GIS) client ID for sign-in: a GIS client ID alone
# is not cloud sign-in proof.
# VITE_GOOGLE_CLIENT_ID is only used by device-local tooling and may stay unset.

# PhonePe Configuration (UPI Payments) — optional provider.
# Leaving BOTH values unset treats PhonePe as intentionally disabled (the audit
# reports it as not applicable, not as verified). Setting only one fails the
# audit as a partial configuration. Production launch requires the production
# endpoint, not sandbox/preprod.
# Note: Salt key must be configured server-side via Supabase Edge Functions
# VITE_PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
# VITE_PHONEPE_API_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# App Configuration
VITE_APP_URL=http://localhost:5173

# Razorpay Configuration — the selected production payment provider.
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_ALLOW_TEST_RAZORPAY_ON_PRODUCTION=false

# Google Maps Configuration
# Get your API key from: https://developers.google.com/maps/documentation/javascript/get-api-key
# Required APIs: Maps JavaScript API, Directions API (optional), Places API (optional)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Note: If VITE_GOOGLE_MAPS_API_KEY is not set, the app will fallback to Leaflet/OpenStreetMap

# Sentry Error Tracking (optional)
# Get your DSN from: https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/
VITE_SENTRY_DSN=
