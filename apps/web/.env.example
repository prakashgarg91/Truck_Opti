# TruckOpti Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=sqlite:///truckopti.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/truckopti

# =============================================================================
# REDIS (for session caching and rate limiting)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# FREE OTP AUTHENTICATION OPTIONS
# Choose ONE or MORE of these - ALL ARE COMPLETELY FREE!
# =============================================================================

# OPTION 1: TELEGRAM BOT (RECOMMENDED - Instant, Unlimited, FREE!)
# ----------------------------------------------------------------
# How to set up:
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot command
# 3. Name your bot "TruckOpti OTP Bot"
# 4. Copy the token you receive and paste below
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# OPTION 2: EMAIL OTP (FREE via Gmail SMTP)
# -----------------------------------------
# How to set up:
# 1. Enable 2-Factor Authentication on your Gmail
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an "App Password" (select "Mail" and "Other")
# 4. Copy the 16-character password and paste below
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-gmail@gmail.com
EMAIL_SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=TruckOpti India

# OPTION 3: CONSOLE (For Development Only)
# ----------------------------------------
# Set FLASK_DEBUG=true to enable console output of OTPs
# OTPs will be printed to the server terminal

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_MAX_PER_HOUR=10

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Get credentials from https://console.cloud.google.com/
# Enable "Google+ API" and "People API"
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# =============================================================================
# GOOGLE MAPS API
# =============================================================================
# Enable these APIs in Google Cloud Console:
# - Geocoding API
# - Directions API
# - Distance Matrix API
# - Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =============================================================================
# LOCATION TRACKING
# =============================================================================
LOCATION_UPDATE_INTERVAL=30
LOCATION_STALE_MINUTES=5

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=86400  # 24 hours in seconds
JWT_REFRESH_TOKEN_EXPIRES=604800  # 7 days in seconds

# =============================================================================
# CORS (Frontend URLs)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# FILE UPLOADS
# =============================================================================
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/truckopti.log

# =============================================================================
# INDIA-SPECIFIC
# =============================================================================
# Default currency
DEFAULT_CURRENCY=INR

# Diesel price per liter (update periodically)
FUEL_PRICE_DIESEL=95.0

# Default location (Mumbai)
DEFAULT_LATITUDE=19.0760
DEFAULT_LONGITUDE=72.8777
