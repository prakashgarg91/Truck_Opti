# TruckOpti Development Environment
# AUTO-GENERATED - Copy from .env.example for full options

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True

# Database (SQLite for development)
DATABASE_URL=sqlite:///truckopti.db

# JWT Configuration
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# =============================================================================
# FREE OTP OPTIONS (All free, choose what works for you)
# =============================================================================

# Option 1: TELEGRAM BOT (Recommended - FREE & Unlimited!)
# Create your bot at @BotFather and paste token here
# TELEGRAM_BOT_TOKEN=your-bot-token-here

# Option 2: EMAIL OTP (FREE via Gmail)
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=your-email@gmail.com
# EMAIL_SMTP_PASSWORD=your-app-password

# Option 3: CONSOLE OTP (Development Only)
# With FLASK_DEBUG=true, OTPs will print to console - no config needed!

# =============================================================================
# GOOGLE OAUTH (Create at https://console.cloud.google.com)
# =============================================================================
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# CORS (Frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
