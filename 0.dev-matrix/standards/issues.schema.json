{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "0.dev-matrix issues.json",
  "type": "object",
  "required": ["updatedAt"],
  "properties": {
    "updatedAt": { "type": "string" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "severity"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "severity": { "type": "string" },
          "owner": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
