{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "0.dev-matrix features.json",
  "type": "object",
  "required": ["updatedAt"],
  "properties": {
    "updatedAt": { "type": "string" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "owner": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
