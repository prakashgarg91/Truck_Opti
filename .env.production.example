# TruckOpti Production Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-min-32-characters-change-this
DEBUG=False

# Database Configuration
DATABASE_URL=postgresql://truckopti_user:secure_password@localhost:5432/truckopti_production

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-min-32-characters-change-this

# Redis (Caching & Sessions)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (SendGrid example)
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-api-key
MAIL_DEFAULT_SENDER=noreply@truckopti.com

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=truckopti-production-files
AWS_S3_REGION=us-east-1

# Monitoring (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# CORS Origins (comma-separated)
CORS_ORIGINS=https://truckopti.com,https://www.truckopti.com,https://app.truckopti.com

# Logging
LOG_LEVEL=INFO

# Celery (Background Tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Feature Flags
FEATURE_REGISTRATION_ENABLED=true
FEATURE_SOCIAL_LOGIN_ENABLED=true
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true

# Application Settings
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=INR
DEFAULT_LANGUAGE=en

# Performance
WORKERS=4
THREADS=2
MAX_CONNECTIONS=100
