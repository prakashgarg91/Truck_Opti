# Proof environment contract for authenticated browser checks and demo-account seeding.
# Copy the required values into one of the loaded local files:
#   .env.proof.local, .env.local, .env, frontend/.env.local, frontend/.env

# Required for authenticated proof routes such as `npm run test:live-auth`
SEED_DEMO_PASSWORD=

# Optional dedicated password for the external Razorpay reviewer account `demo.razorpay`.
# If omitted, the reviewer account falls back to SEED_DEMO_PASSWORD.
RAZORPAY_REVIEW_DEMO_PASSWORD=

# Optional proof target override. Defaults to https://www.truckopti.in
PROOF_BASE_URL=

# Required only when re-seeding the demo accounts and driver-trip fixture
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional dev-only quick-login lane for the local frontend test-payment page
VITE_TEST_EMAIL=
VITE_TEST_PASSWORD=